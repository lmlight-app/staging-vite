# DigitalBase (docker compose) の設定。docker-compose.yml と同じ dir に .env として置く。
# 書いた行は compose の変数にもアプリの環境変数にもなる。他の項目は 管理画面 > 環境変数 を参照。

# ── install-docker.sh が書く (--platform / --version / --port。手で変えてもよい) ──
COMPOSE_PROFILES=              # vLLM を同じ stack で: cuda (NVIDIA) | rocm (AMD) | xpu (Intel)。空 = 同梱しない
#LLM_BACKEND=ollama            # ollama | vllm (COMPOSE_PROFILES を入れると vllm)
#VLLM_BASE_URL=http://vllm-chat:8000
#VLLM_EMBED_BASE_URL=http://vllm-embed:8000
#DB_IMAGE_TAG=latest           # 版を固定する時は 20261005.2 の形
#APP_PORT=8000
#DB_PASSWORD=                  # 同梱 PostgreSQL のパスワード (初回に乱数で入る。後から変えると DB に入れなくなる)

# ── 同梱の vLLM ─────────────────────────────────────────────────
#VLLM_CHAT_MODEL=Qwen/Qwen3-1.7B
#VLLM_EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B
#VLLM_TOOL_CALL_PARSER=hermes   # モデルの系統に合わせる (Qwen3 は hermes / qwen3)
#VLLM_REASONING_PARSER=qwen3
#LLM_CONTEXT_LENGTH=32768
#VLLM_GPU_MEMORY_UTILIZATION_CHAT=0.70
#VLLM_GPU_MEMORY_UTILIZATION_EMBED=0.10
#VLLM_IMAGE_TAG=latest
#HF_TOKEN=                      # gated モデルの時
#HF_CACHE_DIR=./hf-cache        # モデルの置き場

# ── 外の PostgreSQL / LLM を使う (書いた時だけ有効) ──────────────
#DATABASE_URL=postgresql://digitalbase:password@db.example.local:5432/digitalbase
#OLLAMA_BASE_URL=http://host.docker.internal:11434

# ── アプリ (よく使うもの) ────────────────────────────────────────
#OPENAI_API_KEY=
#ANTHROPIC_API_KEY=
#AUTH_MODE=local               # local | ldap | oidc
#JWT_SECRET=                   # 未指定なら初回起動時に data/ に生成して永続
#OAUTH_ENCRYPTION_KEY=         # 同上。変えると保存済みの OAuth 連携が読めなくなる
