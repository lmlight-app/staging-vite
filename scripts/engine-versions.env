# 推論エンジン等の固定版 (= 正本)。promote.sh が latest.json に焼き込み、install-linux-{vllm,sglang}.sh が
# latest.json の同名 key (vllm_version / sglang_version / uv_version / torch_index) を読んで版固定 install する。
# 版を上げる手順: ここを書き換える → 実機で検証 → promote.sh (latest.json 再生成 + scripts 再配布)。
VLLM_VERSION=0.27.1
SGLANG_VERSION=0.5.18
UV_VERSION=0.12.1
# PyTorch wheel index URL。空 = uv の --torch-backend=auto (CUDA ドライバ版から自動選択)
TORCH_INDEX=
