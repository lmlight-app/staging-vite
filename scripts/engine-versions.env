# 推論エンジン等の版指定 (= 正本)。promote.sh が latest.json に焼き込み、install-linux-{vllm,sglang}.sh が
# latest.json の同名 key (vllm_version / sglang_version / uv_version / torch_index) を読んで install する。
# 値: latest (= install 時点の PyPI 最新、既定) | nightly (vLLM のみ、wheels.vllm.ai) | X.Y.Z (版固定)。
# 新しいモデルは新しいエンジンが要るので既定は latest。特定版で問題が出たら admin > モデル管理 から版を変えられる。
VLLM_VERSION=latest
SGLANG_VERSION=latest
UV_VERSION=0.12.1
# PyTorch wheel index URL。空 = uv の --torch-backend=auto (CUDA ドライバ版から自動選択)
TORCH_INDEX=
